            } catch (e) {}

            var dark = pref === 'dark' ||
                (pref === 'system' &&
                window.matchMedia('(prefers-color-scheme: dark)').matches);

            root.classList.toggle('dark', dark);
            root.style.colorScheme = dark ? 'dark' : 'light';

            // Apply the sidebar preference before first paint.
            try {
